# ~/.tmuxinator/stage_planning.yml 

name: stage_planning
root: ~/
windows:
  - stage_main:
      layout: ad59,84x44,0,0{41x44,0,0[41x15,0,0,0,41x15,0,16,2,41x12,0,32,3],42x44,42,0[42x22,42,0{1x22,42,0,1,40x22,44,0,5},42x21,42,23{1x21,42,23,4,40x21,44,23[40x8,44,23,6,40x12,44,32,7]}]}
      panes:
        - graph_management:
          - cde
          - sleep 6  
          - roslaunch stage_planner graph_management.launch 
        - stage_interface:
          - cde 
          - sleep 6 
          - roslaunch stage_planner stage_interface.launch 
        - control_interface:
          - cde
          - sleep 2  
          - roslaunch stage_planner control_interface.launch 
        - extra:
          - cde 
          # - rostopic pub /state std_msgs/String "data: 'PATH'"
        - rotors:
          - cde 
          - sleep 1 
          - roslaunch rotors_gazebo custom_drone.launch 
        - path_pub:  
          - cde 
        - pub:
          - cde 
        - roscore: 
          - roscore 

  - publishers:
      layout: main-vertical 
      panes:
        - one:
          - cde
        - two:
          - cde 

