<?xml version="1.0" ?>
<launch>
  <env name="ROSCONSOLE_FORMAT" value="[${severity}] : ${message}"/>

      <param name="/ODOM_FRAME_ID_" type="str" value="world"/>

      <param name="/INITIALIZE_" type="bool" value="true" />

      <param name="/FIRST_REF_X_" type="double" value="4" />
      <param name="/FIRST_REF_Y_" type="double" value="0" />
      <param name="/FIRST_REF_Z_" type="double" value="1" />
      
      <param name="/RESOLUTION_" type="double" value="0.2" />

      <param name="/MIN_DIST_NODE_" type="double" value="0.6" />
            
      <param name="/SAFETY_MARGIN_" type="double" value="0.5" />

      <param name="/MAX_EDGE_LENGTH_" type="double" value="4" />

      <param name="/MAX_EDGE_LENGTH_HOMING" type="double" value="8" />

      <param name="/NEXT_PUB_DISTANCE_" type="double" value="0.5" />
      
      <param name="/LOCAL_RANGE_" type="double" value="14" />
      
      <param name="/RAW_GRAPH_COLISSION_MARGIN_" type="double" value="0.5" />
      
      <param name="/PLANNING_GRAPH_COLISSION_MARGIN_" type="double" value="0.5" />
      
      <param name="/RAW_FRONTIERS_COLISSION_MARGIN_" type="double" value="0.5" />
      
      <param name="/PLANNING_CHECK_DEPTH_" type="double" value="0" />
      
      <param name="/MIN_ITERATION_LOCAL_" type="double" value="2000" />
      
      <param name="/MIN_ITERATION_GLOBAL_" type="double" value="2000" />
      
      <param name="/MIN_PLANNING_SPACE_LOCAL_" type="double" value="15" />
      
      <param name="/MIN_PLANNING_SPACE_GLOBAL_" type="double" value="20" />
      
      <param name="/MAX_ITERATION_LOCAL_" type="double" value="6000" />
      
      <param name="/MAX_ITERATION_GLOBAL_" type="double" value="20000" />
      
      <param name="/MAX_PLANNING_SPACE_LOCAL_" type="double" value="40" />
      
      <param name="/MAX_PLANNING_SPACE_GLOBAL_" type="double" value="100" />
      
      <param name="/IMPROVEMENT_SCALE_FACTOR_IT_" type="double" value="1" />
      
      <param name="/IMPROVEMENT_SCALE_FACTOR_RANGE_" type="double" value="1" />
      
      <node pkg="acl_exploration" type="aerial_robot_node" name="aerial_robot_node" output="screen">

      <remap from="/ODOMETRY_IN_" to="/hummingbird/ground_truth/odometry"/>
      
      <!-- <remap from="/ODOMETRY_IN_" to="/odometry/imu" /> -->

      <remap from="/REF_TOPIC_" to="/hummingbird/reference" />
      
      <!-- <remap from="/REF_TOPIC_" to="/shafter3d/reference" /> -->

      <remap from="/PATH_TOPIC_" to="/hummingbird/exploration_path" />
      
      <!-- <remap from="/PATH_TOPIC_" to="shafter3d/exploration_path" /> -->

      <remap from="/UFOMAP_" to="/ufomap_mapping_server_node/map"/>

  </node> 


</launch>
