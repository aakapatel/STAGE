<?xml version="1.0" ?>
<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] : ${message}"/>
  
  <node pkg="stage_planner" type="stage_interface_node" name="stage_interface_node" output="screen">

    
    <param name="robot_aerial" type="bool" value="false" />
 
    <param name="frame_id" type="string" value="world" />

		<param name="odometry" value="/odom" />

    <param name ="reference_topic" value="/spot/reference" />

    <!-- <param name ="reference_topic" value="/hummingbird/reference" /> -->


    <param name ="init_x" value="1" />
    <param name ="init_y" value="0" />
    <param name ="init_z" value="0.2" />

    <param name ="distance_to_new_path" value="1" />

  </node>

</launch>
