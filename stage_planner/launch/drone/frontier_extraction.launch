<?xml version="1.0" ?>
<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] : ${message}"/>
  
<!-- UFOMAP SERVER -->
	
		<arg name="resolution" default="0.3" />
		<arg name="depth_levels" default="16" />
		<arg name="num_workers" default="1" />
		<arg name="color" default="true" />

    <node pkg="ufomap_mapping" type="ufomap_mapping_server_node" name="ufomap_mapping_server_node" output="screen" required="true">
		
		  <param name="cloud_in" value="/hummingbird/velodyne_points" />
		  <param name="frame_id" type="string" value="world" />
		  <remap from="cloud_in" to="/hummingbird/velodyne_points" />
      <param name="robot_frame_id" value="hummingbird/base_link" />
		  <param name="num_workers" value="$(arg num_workers)" />
		  <param name="max_range" value="5" />
		  <param name="min_range" value="0.5" />
		  <param name="robot_radius" value="0.5" />
		  <param name="robot_height" value="0.5" />
		  <param name="compress" value="True" />
		  <param name="clear_robot" value="True" />
		  <param name="clearing_depth" value="0" />
		  <param name="publish_depth" value="4" />
		  <param name="pub_rate" value="1" />
		  <param name="insert_depth" value="0" />
		  <param name="resolution" value="$(arg resolution)" />
		  <param name="depth_levels" value="$(arg depth_levels)" />
		  <param name="color_map" value="$(arg color)"/>
    </node> 
    
    
  <node pkg="stage_planner" type="frontiers_extraction_node" name="frontiers_extraction_node" output="screen">

    <!-- VERY IMPORTANT TO SET CORRECT ROBOT TYPE -->

    <param name="robot_aerial" value="true" />
    

    <param name="xFiltering" value="true" />
		<param name="yFiltering" value="true" />
		<param name="zFiltering" value="true" />

		<param name="resolution" value="0.5" />
		<param name="cloud_in" value="/hummingbird/velodyne_points" />
		<param name="distance" value="4" />
		<param name="frame_id" type="string" value="world" />
		<param name="sensor_model/max_range" value="5" />
		<param name="odometry" value="/hummingbird/ground_truth/odometry" />
		<remap from="cloud_in" to="/hummingbird/velodyne_points" />
		<param name="number_of_unknowns" value="12" />
		<param name="local_sliding_space" value="12" />
		<param name="local_field_of_view" value="40" />
		<param name="safety_height" value = "6" />
		<param name="traversability_radius" value="1" />
		<param name="planning_check_depth" value="1" />
		<param name="volumetric_gain_threashold" value="1" />
    


		<remap from="ufomap" to="/ufomap_mapping_server_node/map" />


  </node>
  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find stage_planner)/config/rviz/stage_planner_sim.rviz" />
</launch>
