<?xml version="1.0" ?>
<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] : ${message}"/>
  
  <node pkg="stage_planner" type="stage_interface_node" name="stage_interface_node" output="screen">

    <param name="robot_aerial" type="bool" value="true" />

    <param name="frame_id" type="string" value="world" />

		<param name="odometry" value="/hummingbird/ground_truth/odometry" />

    <param name ="reference_topic" value="/hummingbird/command/pose" />

    <param name ="init_x" value="1" />
    <param name ="init_y" value="0" />
    <param name ="init_z" value="0.4" />

    <param name ="distance_to_new_path" value="0.5" />

  </node>


	<node name="control_interface" pkg="stage_planner" type="control_interface" output="screen">

    <param name="robot_aerial" type="bool" value="true" />

    <param name="state_topic" type="string" value="/state"/>
    
    <param name="path_topic" type="string" value="/command_path"/>
    
    <param name="odom_topic" type="string" value="/hummingbird/ground_truth/odometry"/>
    
    <param name="wp_topic" type="string" value="/next_waypoint"/>
    
    <param name="reference_topic" type="string" value="/hummingbird/command/pose"/>

    <param name="WP_SIZE" type="double" value="0.5"/>
    
    <param name="ROTATION_TOLERANCE" type="double" value="0.25"/>
    
    <param name="frame_id" type="string" value="world"/>

  </node>

  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find stage_planner)/config/rviz/stage_planner_sim.rviz" />

</launch>
