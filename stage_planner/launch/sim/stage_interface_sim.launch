<?xml version="1.0" ?>
<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] : ${message}"/>
  <env name="ROSCONSOLE_CONFIG_FILE" value="$(find stage_planner)/custom_rosconsole.conf"/>
  
  <arg name="robot_name" default="hummingbird"/>
  <arg name="mapping_config" default="$(find stage_planner)/config/aerial/voxblox_sim_config.yaml"/>
  <arg name="stage_config" default="$(find stage_planner)/config/aerial/stage_config.yaml"/>
  
  <group ns = "$(arg robot_name)"> 
    
    <node pkg="stage_planner" type="stage_interface_node" name="stage_interface_node" output="screen">

      <remap from="odometry" to="ground_truth/odometry" />
      <remap from="pointcloud" to="ouster/points" />
      <remap from="reference_topic" to="command/pose" />
      <rosparam command="load" file="$(arg mapping_config)" /> 
      <rosparam command="load" file="$(arg stage_config)" /> 

      </node>


    <node name="control_interface" pkg="stage_planner" type="control_interface" output="screen">

      <param name="state_topic" type="string" value="/state"/>

      <param name="frame_id" type="string" value="world" />
      
      <param name="path_topic" type="string" value="command_path"/>

      <param name="odom_topic" type="string" value="ground_truth/odometry"/>

      <param name="wp_topic" type="string" value="/next_waypoint"/>

      <param name="reference_topic" type="string" value="command/pose"/>

      <rosparam command="load" file="$(arg stage_config)" /> 

      </node>

  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find stage_planner)/config/rviz/stage_planner_$(arg robot_name).rviz" />

    </group>
  

</launch>
