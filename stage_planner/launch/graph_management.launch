<?xml version="1.0" ?>
<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] : ${message}"/>
  
  <arg name="robot_name" default="hummingbird"/>




  <arg name="gbplanner_config_file" default="$(find stage_planner)/config/$(arg robot_name)/gbplanner_config.yaml"/>
  <arg name="pci_file" default="$(find stage_planner)/config/$(arg robot_name)/planner_control_interface_sim_config.yaml"/>
  <arg name="voxblox_config_file" default="$(find stage_planner)/config/$(arg robot_name)/voxblox_sim_config.yaml"/>
  <arg name="map_config_file" default="$(arg voxblox_config_file)"/>

  <node pkg="stage_planner" type="graph_management_node" name="graph_management_node" respawn="true" output="screen">

    <!-- VERY IMPORTANT TO SET CORRECT ROBOT TYPE -->

    <param name="robot_aerial" value="true" />
    
    <param name="frame_id" type="string" value="world" />

		<param name="odometry" value="/hummingbird/ground_truth/odometry" />

		<remap from="ufomap" to="/ufomap_mapping_server_node/map" />

    <param name="local_sliding_space" value="12" />

    <param name="max_global_planning_space" value="20" />
    
    <param name="local_field_of_view" value="40" />
    
    <param name="safety_height" value = "4" />
    
    <param name="traversability_radius" value="0.4" />
    
    <param name="planning_check_depth" value="1" />
    
    <param name="volumetric_gain_threashold" value="1" />

    <param name="graph_density_coefficient" value="0.3" />

    <param name="maximum_edge_length" value="2" /> 

    <param name ="maximum_iterations_local" value="1500" />

    <param name ="safety_margin" value="0.8" />
    <param name ="robot_x" value="0.8" />
    <param name ="robot_y" value="0.8" />
    <param name ="robot_z" value="0.4" />

    <remap from="odometry" to="/hummingbird/ground_truth/odometry" />
    <remap from="/pointcloud" to="/hummingbird/velodyne_points" />
    <rosparam command="load" file="$(arg gbplanner_config_file)" />
    <rosparam command="load" file="$(arg map_config_file)" /> 

  </node>


</launch>
