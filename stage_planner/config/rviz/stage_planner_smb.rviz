Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Axes1
        - /MarkerArray1
        - /MarkerArray2
        - /MarkerArray2/Namespaces1
        - /Path1
        - /MarkerArray3
        - /MarkerArray3/Namespaces1
        - /MarkerArray4
        - /PointCloud21
        - /MarkerArray5
        - /MarkerArray6
        - /MarkerArray6/Namespaces1
        - /MarkerArray7
        - /MarkerArray8
        - /MarkerArray9
        - /MarkerArray10
        - /MarkerArray11
        - /Path2
        - /Pose1
        - /Odometry1
        - /Path3
        - /Path4
        - /MarkerArray12
        - /MarkerArray12/Namespaces1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: PointCloud2
  - Class: stage_planner_ui/STAGE INTERFACE
    Name: STAGE INTERFACE
  - Class: spot_ui/SPOT INTERFACE
    Name: SPOT INTERFACE
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
